# Application database. Tests use this same database and truncate it after each test.
DATABASE_URL=postgresql+asyncpg://tasktracker:tasktracker@localhost:5432/tasktracker

# At least 32 characters. Generate a unique value before any shared deployment.
JWT_SECRET_KEY=dev-only-secret-key-change-in-production-32

ENVIRONMENT=local
LOG_LEVEL=INFO
DB_ECHO=false

# Local administrator created on API startup when both values are set.
# Leave the password empty to disable bootstrap.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Adminpass1
BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# Comma-separated browser origins. Empty disables CORS.
CORS_ORIGINS=http://localhost:3000

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
